# Database Configuration
DATABASE_URL="postgresql://callops:callops_dev@localhost:5432/callops"

# Knowledge Vault Configuration
EMBEDDING_MODEL="gemini-embedding-001"
EMBEDDING_DIM=768
RERANKER_MODEL="cross-encoder/ms-marco-MiniLM-L-6-v2"
MIN_RERANK_SCORE=-8.5

# Generative Model Configuration
INVESTIGATOR_LLM_MODEL="gemini-2.5-flash"
VOICE_AGENT_LLM_MODEL="gemini-2.5-flash"

# Voice Pipeline Providers (Primary Google AI Studio & Fallback Vertex AI)
GEMINI_API_KEY=""
GEMINI_LIVE_MODEL="gemini-3.8-live"
FALLBACK_GEMINI_LIVE_MODEL="gemini-live-2.5-flash-native-audio"
GOOGLE_CLOUD_PROJECT=""
GOOGLE_CLOUD_LOCATION="us-central1"
GEMINI_LIVE_VOICE="Puck"

STT_PROVIDER="deepgram"
TTS_PROVIDER="google-tts"

# LiveKit Configuration
LIVEKIT_URL="ws://localhost:7880"
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="secret"

# Telephony Safety Controls (Modes: "livekit-rtc", "fake", "browser", "twilio", "livekit-sip")
TELEPHONY_MODE="livekit-rtc"
TELEPHONY_KILL_SWITCH="false"
TELEPHONY_ALLOWLIST='["+15555550100", "+15555550199"]'
MAX_CALLS_PER_HOUR=10
RECORDING_ENABLED="false"

# Optional Twilio PSTN Credentials (only used when TELEPHONY_MODE="twilio")
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Gateway & Ingest Configuration
HMAC_SECRET="dev-secret-key-1234"
GROUPING_WINDOW_SECONDS=60
TEMPORAL_HOST="localhost:7233"

# Observability & Langfuse Configuration
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""
LANGFUSE_BASE_URL="https://cloud.langfuse.com"
